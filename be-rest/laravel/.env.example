# =====================================================================
# Laravel REST — Environment Configuration
# Per spec/21-app/00-rest-general/spec.md
# Switch DB by changing DB_CONNECTION to: sqlite | mysql | pgsql
# =====================================================================

APP_NAME=LaravelRest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Database — choose ONE driver via DB_CONNECTION
# ---------------------------------------------------------------------
DB_CONNECTION=sqlite

# SQLite (default, file-based)
DB_DATABASE=database/database.sqlite

# MySQL — uncomment and set DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_rest
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL — uncomment and set DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel_rest
# DB_USERNAME=postgres
# DB_PASSWORD=

# ---------------------------------------------------------------------
# File storage (for /file-upload, /file-serve)
# ---------------------------------------------------------------------
FILESYSTEM_DISK=local
UPLOAD_MAX_SIZE_MB=10

# ---------------------------------------------------------------------
# Auth — research placeholders (JWT, OAuth) — not implemented yet
# ---------------------------------------------------------------------
# JWT_SECRET=
# JWT_TTL=60
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
