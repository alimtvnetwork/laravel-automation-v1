APP_NAME=BeRestLaravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Switch driver: sqlite | mysql | pgsql
DB_CONNECTION=sqlite

# SQLite
DB_DATABASE=database/database.sqlite

# MySQL / PostgreSQL (used when DB_CONNECTION=mysql|pgsql)
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_PORT=5432   # for pgsql
# DB_DATABASE=berest
DB_USERNAME=root
DB_PASSWORD=

# File storage
FILESYSTEM_DISK=local

# Auth (planned)
JWT_SECRET=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
